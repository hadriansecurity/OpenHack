{
  "review_depth": "scenario-first",
  "workflow_mode": "human_checkpoints",
  "router_coverage": "explicit_path_and_expert_decisions",
  "optional_recon_providers": ["semgrep"],
  "source_checkout": "fresh-clone",
  "max_public_python_commands": 20,
  "max_invocable_wrapper_loc": 50,
  "log_policy": {
    "location": "runs/<target>/<run-id>/logs/",
    "contents": ["summary", "actions", "evidence", "decision", "next", "status"],
    "excludes": ["private_chain_of_thought"]
  }
}
